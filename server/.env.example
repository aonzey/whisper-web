# Copy to server/.env (or export the variables before starting the server)

PORT=8787

# Optional shared secret. When set, requests must send
# `Authorization: Bearer <API_TOKEN>` or `X-API-Key: <API_TOKEN>`.
API_TOKEN=

# local   -> run 🤗 Transformers.js inside this process (e.g. Xenova/whisper-tiny.en)
# openai  -> forward to an OpenAI compatible endpoint
# command -> run a local CLI (openai-whisper / whisper.cpp / ...)
# (leave empty to auto-select: Xenova/* & distil-whisper/* -> local, otherwise openai)
WHISPER_ENGINE=

# --- engine: local --------------------------------------------------------
# Where the ONNX weights are cached (layout: <dir>/<model_id>/<file>)
# Download them once with:  npm run fetch-model -- <model_id>
LOCAL_CACHE_DIR=.cache
# Model used when the request does not specify one
LOCAL_MODEL=Xenova/whisper-tiny.en
# auto -> offline as soon as the weights are cached; 1/true -> never download
LOCAL_OFFLINE=auto
# Mirror used to download the weights when huggingface.co is unreachable
# (the fetch script prefers ModelScope automatically)
HF_ENDPOINT=https://huggingface.co
# ffmpeg must be available on PATH for the local engine (audio decoding)
# set quantized=false in the request to use the fp32 weights

# --- engine: openai -------------------------------------------------------
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=whisper-1

# --- engine: command ------------------------------------------------------
# Example for the python `whisper` CLI:
WHISPER_COMMAND=whisper
WHISPER_COMMAND_ARGS={file} --model {model} --output_format json --output_dir {outdir}
WHISPER_COMMAND_MODEL=base
WHISPER_COMMAND_TIMEOUT_MS=1800000

# --- translation (POST /api/translate, POST /api/bilingual) ----------------
# local  -> 🤗 Transformers.js translation pipeline (NLLB / m2m100 / opus-mt ...)
# openai -> OpenAI compatible /chat/completions (LLM, context aware)
# (leave empty to auto-select: an upstream_* endpoint -> openai, otherwise local)
TRANSLATION_ENGINE=
# 🤗 model used by the local translation engine
#   npm run fetch-model -- Xenova/opus-mt-en-zh
TRANSLATION_MODEL=Xenova/nllb-200-distilled-600M
# Chat model used by the openai translation engine
TRANSLATION_API_MODEL=gpt-4o-mini
# Default target language for /api/bilingual (zh, zh-Hant, en, ja, ...)
TRANSLATION_TARGET=zh

# Outgoing requests automatically honour HTTP_PROXY / HTTPS_PROXY / NO_PROXY
MAX_UPLOAD_MB=200
